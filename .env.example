# ---------------------------------------------------------------------------
# Retail Clickstream AI — environment configuration (variable NAMES only).
# Copy this file to `.env` and fill in values locally.
# NEVER commit a real `.env`, an API key, or Kaggle credentials.
# ---------------------------------------------------------------------------

# Required ONLY when starting an LLM-backed CrewAI run.
# Not needed to install, import, or run the offline test suite.
OPENAI_API_KEY=

# Any OpenAI model available to your account. Do not hard-code a model in source.
OPENAI_MODEL_NAME=

# Optional application settings.
LOG_LEVEL=INFO
ARTIFACT_ROOT=artifacts
